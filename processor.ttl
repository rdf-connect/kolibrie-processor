@prefix rdfc: <https://w3id.org/rdf-connect#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix : <https://w3id.org/rdf-connect/rust#>.

# ── Processor declaration ─────────────────────────────────────────────────────
#
# This processor is distributed as prebuilt `cdylib`s — one per target triple.
# There is no `rdfc:file` / `builtin://` mechanism: using this processor in a
# pipeline is just `owl:import`ing this file (locally, or over http(s) from a
# release). That single import brings in the class, its argument shape, and —
# transitively, via the `owl:imports` below — its `:abiStable`/`:artifact`
# declarations. The orchestrator's generic SHACL shape (declared once in the
# Rust runner's own `index.ttl`, targeting subjects of
# `:rustImplementationOf`) extracts those straight into `proc.config` as
# JSON, resolving `:path` (declared as an IRI, so relative references
# resolve against wherever the file was itself fetched from) to an absolute
# path/URL along the way. The runner then:
#
#   1. Picks the `:artifact` entry whose `:targetTriple` matches its own
#      compiled target (`rustc --print target-list` naming, e.g.
#      `x86_64-unknown-linux-gnu`).
#   2. Downloads it if `:path` is `http(s)://` (caching by `:sha256`), or
#      opens it directly if it's a local path.
#   3. Verifies the bytes against `:sha256`, when given — omitted entirely
#      skips verification, e.g. for quick local-development iteration.
#   4. Compares `:abiStable` against the runner's own SDK build — a mismatch
#      fails immediately with a clear error, before anything is loaded.
#
# `generated.ttl` doesn't exist until this crate is built (`cargo build` runs
# `build.rs`, which regenerates it every time via `rdfc-processor-buildtools`
# — see build.rs) — it carries this class's `:abiStable` token and a
# *single-target*, checksum-free `:artifact` entry pointing at your own local
# build, always in sync with it. Never hand-edit it; it's gitignored.
#
# A *published* release is different: `.github/workflows/build-processor.yml`
# builds every target triple, computes real checksums, and merges them into
# its own multi-target `kolibrie-generated.ttl`, uploaded alongside a
# `kolibrie.ttl` (a copy of this file with the import target rewritten to
# match) — see that workflow for exactly how.
#
# Usage in a pipeline TTL:
#   <> owl:imports <https://github.com/<org>/kolibrie-processor/releases/download/v0.1.0/kolibrie.ttl>.
#   # (a local checkout works too: <> owl:imports </path/to/kolibrie-processor/processor.ttl>.)
<> owl:imports <generated.ttl>.

rdfc:KolibrieProcessor a rdfc:Processor;
  rdfs:label "Kolibrie Reasoning Processor";
  rdfs:comment "Reads RDF messages (Turtle, TriG, N-Triples or N-Quads, auto-detected) from a stream, applies Datalog rules using the Kolibrie engine, and writes derived facts as N-Triples to an output channel.";
  :rustImplementationOf rdfc:Processor.

# ── SHACL shape — parameters accepted by the processor ───────────────────────
[ ] a sh:NodeShape;
  sh:targetClass rdfc:KolibrieProcessor;
  sh:property [
    sh:path rdfc:reader;
    sh:name "readers";
    sh:class rdfc:Reader;
    sh:minCount 1;
    sh:description "One channel per RSP-QL stream: each Reader's own channel URI is matched against a `FROM NAMED WINDOW ... ON <stream-iri>` clause in rsp_query.";
  ], [
    sh:path rdfc:writer;
    sh:name "writer";
    sh:class rdfc:Writer;
    sh:minCount 1;
    sh:maxCount 1;
    sh:description "Output channel to which derived N-Triples are written.";
  ], [
    sh:path rdfc:rspQuery;
    sh:name "rsp_query";
    sh:datatype xsd:string;
    sh:maxCount 1;
    sh:description "Inline RSP-QL query text (required when rsp_query_file is absent). Declares one named window per stream (each with its own RANGE/STEP — this is how streams at different velocities are expressed) and the WHERE-clause patterns joining them.";
  ], [
    sh:path rdfc:rspQueryFile;
    sh:name "rsp_query_file";
    sh:datatype xsd:anyURI;
    sh:maxCount 1;
    sh:description "Path to a file containing the RSP-QL query text.";
  ], [
    sh:path rdfc:rules;
    sh:name "rules";
    sh:datatype xsd:string;
    sh:maxCount 1;
    sh:description "Inline N3 Datalog rules, applied by forward-chaining materialisation on every window firing (and, independently, on the capped_reader path). Optional.";
  ], [
    sh:path rdfc:rulesFile;
    sh:name "rules_file";
    sh:datatype xsd:anyURI;
    sh:maxCount 1;
    sh:description "Path to a file containing N3 Datalog rules.";
  ], [
    sh:path rdfc:syncPolicy;
    sh:name "sync_policy";
    sh:datatype xsd:string;
    sh:maxCount 1;
    sh:description "Engine-level default multi-window synchronisation policy: \"wait\" (default) or \"steal\". Overridden per-window by a WITH POLICY clause in rsp_query.";
  ], [
    sh:path rdfc:staticReader;
    sh:name "static_reader";
    sh:class rdfc:Reader;
    sh:maxCount 1;
    sh:description "Optional channel of permanent background data: messages accumulate forever (never evicted) and are joined into every window firing via WHERE-clause patterns outside any WINDOW block.";
  ], [
    sh:path rdfc:cappedReader;
    sh:name "capped_reader";
    sh:class rdfc:Reader;
    sh:maxCount 1;
    sh:description "Optional separate stream that keeps only the last max_per_subject messages per RDF subject. Reasons independently of the RSP-QL engine above (see README) since Kolibrie's windows have no API to forcibly evict a specific admitted item early.";
  ], [
    sh:path rdfc:maxPerSubject;
    sh:name "max_per_subject";
    sh:datatype xsd:integer;
    sh:maxCount 1;
    sh:description "Required (> 0) when capped_reader is set: how many of the most recent messages to retain per RDF subject.";
  ], [
    sh:path rdfc:subjectTimeout;
    sh:name "subject_timeout";
    sh:datatype xsd:integer;
    sh:maxCount 1;
    sh:description "Requires capped_reader. Seconds of inactivity after which a subject's tracked entry is evicted entirely, bounding memory even under ever-growing subject cardinality (max_per_subject alone only bounds each existing subject's own queue).";
  ], [
    sh:path rdfc:silenceEvent;
    sh:name "silence_event";
    sh:datatype xsd:string;
    sh:maxCount 1;
    sh:description "Requires subject_timeout. N-Triples line template (with a {subject} placeholder) injected in place of an evicted subject's stale readings, so rules can react to that subject having gone silent.";
  ], [
    sh:path rdfc:cappedDebounceMs;
    sh:name "capped_debounce_ms";
    sh:datatype xsd:integer;
    sh:maxCount 1;
    sh:description "Requires capped_reader. Coalesce capped_reader reasoning passes: wait this many ms after the last change before re-running, instead of on every message. Omit for the fastest (immediate) response.";
  ].

